# Copie para .env.local e preencha. Nunca commite valores reais.
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo da sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
NEXTAUTH_SECRET=

# Em produção (Vercel): URL pública do app. No local, omita.
# NEXTAUTH_URL=https://seu-app.vercel.app

# E-mails autorizados, separados por vírgula. Lista vazia = nega tudo.
ALLOWED_EMAILS=voce@gmail.com

# Leitura do Sheets via Service Account (etapa treinos).
# Compartilhe a planilha com o e-mail abaixo como Leitor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada JSON com \n literais (uma linha só).
GOOGLE_PRIVATE_KEY=
SPREADSHEET_ID=1XZhiD2i7qtDu3tuC1A7Cfp0ExpbqyTLoQjFwMIS-zN0
